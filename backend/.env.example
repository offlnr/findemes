# Local development values. Copy the lines you need into backend/.env.local (git-ignored).
# These match docker-compose.yml and are NOT used in any shared environment.

# Owner role: migrations only. Services never connect with it.
MIGRATION_DATABASE_URL=postgres://findemes_owner:local_owner_password@127.0.0.1:5432/findemes

# Database tests (`pnpm test:db`): owner role of a LOCAL server; the suite refuses other hosts.
TEST_DATABASE_URL=postgres://findemes_owner:local_owner_password@127.0.0.1:5432/postgres

# Login roles created by `pnpm db:migrate` (at least 16 characters).
API_DB_PASSWORD=local_api_password_change_me
ADMIN_DB_PASSWORD=local_admin_password_change_me

# Fintoc test mode (dashboard > API Keys), both or neither. Never commit real values. Only
# sk_test_/pk_test_ keys are accepted; without them the app offers only the demo bank.
FINTOC_PUBLIC_KEY=
FINTOC_SECRET_KEY=
# AES-256-GCM key for the bank link tokens: 32 random bytes in base64url (required with DATABASE_URL).
BANK_TOKEN_KEY=

# Public API: exact origins of the web app allowed by CORS (comma separated, no wildcards).
# `flutter run -d web-server --web-port 8080` serves the app here.
CORS_ORIGINS=http://localhost:8080

# Identity (optional: without DATABASE_URL the API serves only the demo mode).
# API login role created by `pnpm db:migrate` with API_DB_PASSWORD.
DATABASE_URL=postgres://findemes_api:local_api_password_change_me@127.0.0.1:5432/findemes
# 32+ random bytes in base64url, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
IDENTITY_HMAC_KEY=
APP_BASE_URL=http://localhost:8080

# Email. Development: files in backend/.outbox by default; EMAIL_TRANSPORT=smtp sends to Mailpit
# (docker compose service `mail`, inbox at http://localhost:8025). Production: Amazon SES SMTP
# (email-smtp.us-east-1.amazonaws.com:587) with its SMTP credentials and a verified EMAIL_FROM.
EMAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
EMAIL_FROM=Fin de Mes <no-responder@findemes.cl>

# Admin API (pnpm dev:admin-api, port 3001). Login role created by `pnpm db:migrate` with
# ADMIN_DB_PASSWORD; it cannot read financial tables (HU23). Create an administrator with
# `pnpm admin:create <email>` (existing verified account) and add the TOTP to an authenticator.
ADMIN_DATABASE_URL=postgres://findemes_admin:local_admin_password_change_me@127.0.0.1:5432/findemes
# 32+ random bytes in base64url, different from JWT_SECRET.
ADMIN_JWT_SECRET=
# Exactly 32 random bytes in base64url: encrypts the administrators' TOTP secrets.
ADMIN_TOTP_KEY=
# Exact origin of the admin panel (`flutter run -d web-server --web-port 8090` in admin/).
ADMIN_CORS_ORIGINS=http://localhost:8090
PUBLIC_API_HEALTH_URL=http://127.0.0.1:3000/health

# Webpay Plus (HU19). Default: Transbank integration environment with its public test
# credentials (no real charges). Production needs its own commerce code and key.
WEBPAY_ENVIRONMENT=integration
# WEBPAY_COMMERCE_CODE=
# WEBPAY_API_KEY=
# Public URL of this API: Transbank sends the browser back to API_PUBLIC_URL/v1/payments/webpay/return.
API_PUBLIC_URL=http://localhost:3000
