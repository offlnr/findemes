{
  "name": "@findemes/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "node --watch src/composition/main-api.ts",
    "dev:admin-api": "node --watch src/composition/main-admin-api.ts",
    "openapi:generate": "node src/composition/generate-openapi.ts",
    "db:migrate": "node --env-file-if-exists=.env.local src/composition/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/core/tsconfig.json --noEmit",
    "depcruise": "depcruise src test --config .dependency-cruiser.cjs",
    "test": "vitest run --coverage",
    "test:core": "vitest run src/core --coverage",
    "test:db": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.db.config.ts",
    "smoke:webpay": "node src/composition/smoke/webpay-smoke.ts",
    "smoke:fintoc": "node --env-file-if-exists=.env.local src/composition/smoke/fintoc-smoke.ts",
    "smoke:email": "node --env-file-if-exists=.env.local src/composition/smoke/email-smoke.ts",
    "smoke": "pnpm smoke:webpay && pnpm smoke:fintoc && pnpm smoke:email"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.5.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.3",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.5",
    "jose": "~6.2.12",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  }
}
