<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="defs_sp_estado" targetNamespace="https://findemes.cl/bpmn" exporter="generate_bpmn.py">
<bpmn:collaboration id="collab_sp_estado">
<bpmn:participant id="pool_sp_estado" name="Usuario" processRef="proc_sp_estado"/>
</bpmn:collaboration>
<bpmn:process id="proc_sp_estado" name="Actualizar el estado base" isExecutable="false">
<bpmn:startEvent id="s1_start" name=""><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
<bpmn:exclusiveGateway id="s1_banco" name="¿Tiene un banco vinculado?"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing><bpmn:outgoing>f3</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="s1_sync" name="Sincronizar los movimientos del banco"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="s1_manual" name="Registrar ingresos, gastos, deudas y saldo"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="s1_merge" name=""><bpmn:incoming>f4</bpmn:incoming><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="s1_revisa" name="Revisar la proyección del estado base"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="s1_end" name=""><bpmn:incoming>f7</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" name="" sourceRef="s1_start" targetRef="s1_banco"/>
<bpmn:sequenceFlow id="f2" name="Sí" sourceRef="s1_banco" targetRef="s1_sync"/>
<bpmn:sequenceFlow id="f3" name="No" sourceRef="s1_banco" targetRef="s1_manual"/>
<bpmn:sequenceFlow id="f4" name="" sourceRef="s1_sync" targetRef="s1_merge"/>
<bpmn:sequenceFlow id="f5" name="" sourceRef="s1_manual" targetRef="s1_merge"/>
<bpmn:sequenceFlow id="f6" name="" sourceRef="s1_merge" targetRef="s1_revisa"/>
<bpmn:sequenceFlow id="f7" name="" sourceRef="s1_revisa" targetRef="s1_end"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="dia_sp_estado" name="Actualizar el estado base"><bpmndi:BPMNPlane id="plane_sp_estado" bpmnElement="collab_sp_estado">
<bpmndi:BPMNShape id="pool_sp_estado_di" bpmnElement="pool_sp_estado" isHorizontal="true"><dc:Bounds x="107" y="55" width="771" height="280"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="s1_start_di" bpmnElement="s1_start"  bioc:fill="#E6FF97" bioc:stroke="#62A715" color:background-color="#E6FF97" color:border-color="#62A715"><dc:Bounds x="177" y="172" width="36" height="36"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="s1_banco_di" bpmnElement="s1_banco" isMarkerVisible="true" bioc:fill="#FFFFCC" bioc:stroke="#A6A61D" color:background-color="#FFFFCC" color:border-color="#A6A61D"><dc:Bounds x="255" y="165" width="50" height="50"/><bpmndi:BPMNLabel color:color="#000000"><dc:Bounds x="180" y="222" width="110" height="32"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="s1_sync_di" bpmnElement="s1_sync"  bioc:fill="#ECEFFF" bioc:stroke="#03689A" color:background-color="#ECEFFF" color:border-color="#03689A"><dc:Bounds x="345" y="95" width="150" height="80"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="s1_manual_di" bpmnElement="s1_manual"  bioc:fill="#ECEFFF" bioc:stroke="#03689A" color:background-color="#ECEFFF" color:border-color="#03689A"><dc:Bounds x="345" y="215" width="150" height="80"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="s1_merge_di" bpmnElement="s1_merge" isMarkerVisible="true" bioc:fill="#FFFFCC" bioc:stroke="#A6A61D" color:background-color="#FFFFCC" color:border-color="#A6A61D"><dc:Bounds x="535" y="165" width="50" height="50"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="s1_revisa_di" bpmnElement="s1_revisa"  bioc:fill="#ECEFFF" bioc:stroke="#03689A" color:background-color="#ECEFFF" color:border-color="#03689A"><dc:Bounds x="615" y="150" width="150" height="80"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="s1_end_di" bpmnElement="s1_end"  bioc:fill="#EEAAAA" bioc:stroke="#990000" color:background-color="#EEAAAA" color:border-color="#990000"><dc:Bounds x="802" y="172" width="36" height="36"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="213" y="190"/><di:waypoint x="255" y="190"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="280" y="165"/><di:waypoint x="280" y="135"/><di:waypoint x="345" y="135"/><bpmndi:BPMNLabel><dc:Bounds x="286" y="145" width="30" height="16"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="280" y="215"/><di:waypoint x="280" y="255"/><di:waypoint x="345" y="255"/><bpmndi:BPMNLabel><dc:Bounds x="286" y="221" width="30" height="16"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="495" y="135"/><di:waypoint x="560" y="135"/><di:waypoint x="560" y="165"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="495" y="255"/><di:waypoint x="560" y="255"/><di:waypoint x="560" y="215"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="585" y="190"/><di:waypoint x="615" y="190"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="765" y="190"/><di:waypoint x="802" y="190"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
