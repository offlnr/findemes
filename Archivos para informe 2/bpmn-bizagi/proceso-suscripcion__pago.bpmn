<bpmndi:BPMNEdge id="fp7_di" bpmnElement="fp7"><di:waypoint x="1185" y="560"/><di:waypoint x="1225" y="560"/><bpmndi:BPMNLabel><dc:Bounds x="1191" y="542" width="30" height="16"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fp8_di" bpmnElement="fp8"><di:waypoint x="1160" y="585"/><di:waypoint x="1160" y="660"/><di:waypoint x="1225" y="660"/><bpmndi:BPMNLabel><dc:Bounds x="1166" y="591" width="30" height="16"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fp9_di" bpmnElement="fp9"><di:waypoint x="1375" y="660"/><di:waypoint x="1415" y="660"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fp10_di" bpmnElement="fp10"><di:waypoint x="1075" y="740"/><di:waypoint x="1440" y="740"/><di:waypoint x="1440" y="685"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fp11_di" bpmnElement="fp11"><di:waypoint x="1375" y="560"/><di:waypoint x="1415" y="560"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fp11b_di" bpmnElement="fp11b"><di:waypoint x="1440" y="635"/><di:waypoint x="1440" y="585"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fp12_di" bpmnElement="fp12"><di:waypoint x="1465" y="560"/><di:waypoint x="1532" y="560"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="n_idem_a_di" bpmnElement="n_idem_a"><di:waypoint x="1500" y="700"/><di:waypoint x="1458" y="672"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
