<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="defs_sp_vencimiento" targetNamespace="https://findemes.cl/bpmn" exporter="generate_bpmn.py">
<bpmn:collaboration id="collab_sp_vencimiento">
<bpmn:participant id="pool_sp_vencimiento" name="Fin de Mes" processRef="proc_sp_vencimiento"/>
</bpmn:collaboration>
<bpmn:process id="proc_sp_vencimiento" name="Vencimiento y renovación" isExecutable="false">
<bpmn:startEvent id="v_start" name=""><bpmn:outgoing>fv1</bpmn:outgoing></bpmn:startEvent>
<bpmn:exclusiveGateway id="v_renovo" name="¿Se renovó el plan?"><bpmn:incoming>fv1</bpmn:incoming><bpmn:outgoing>fv2</bpmn:outgoing><bpmn:outgoing>fv3</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="v_vigente" name="Nuevo período vigente"><bpmn:incoming>fv2</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="v_gratis" name="Pasar al plan gratuito conservando todos los datos"><bpmn:incoming>fv3</bpmn:incoming><bpmn:outgoing>fv4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:sendTask id="v_aviso" name="Avisar al usuario por correo"><bpmn:incoming>fv4</bpmn:incoming><bpmn:outgoing>fv5</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="v_end" name="Plan gratuito vigente"><bpmn:incoming>fv5</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="fv1" name="" sourceRef="v_start" targetRef="v_renovo"/>
<bpmn:sequenceFlow id="fv2" name="Sí" sourceRef="v_renovo" targetRef="v_vigente"/>
<bpmn:sequenceFlow id="fv3" name="No" sourceRef="v_renovo" targetRef="v_gratis"/>
<bpmn:sequenceFlow id="fv4" name="" sourceRef="v_gratis" targetRef="v_aviso"/>
<bpmn:sequenceFlow id="fv5" name="" sourceRef="v_aviso" targetRef="v_end"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="dia_sp_vencimiento" name="Vencimiento y renovación"><bpmndi:BPMNPlane id="plane_sp_vencimiento" bpmnElement="collab_sp_vencimiento">
<bpmndi:BPMNShape id="pool_sp_vencimiento_di" bpmnElement="pool_sp_vencimiento" isHorizontal="true"><dc:Bounds x="412" y="799" width="808" height="265"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="v_start_di" bpmnElement="v_start"  bioc:fill="#E6FF97" bioc:stroke="#62A715" color:background-color="#E6FF97" color:border-color="#62A715"><dc:Bounds x="482" y="882" width="36" height="36"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="v_renovo_di" bpmnElement="v_renovo" isMarkerVisible="true" bioc:fill="#FFFFCC" bioc:stroke="#A6A61D" color:background-color="#FFFFCC" color:border-color="#A6A61D"><dc:Bounds x="575" y="875" width="50" height="50"/><bpmndi:BPMNLabel color:color="#000000"><dc:Bounds x="545" y="839" width="110" height="32"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="v_vigente_di" bpmnElement="v_vigente"  bioc:fill="#EEAAAA" bioc:stroke="#990000" color:background-color="#EEAAAA" color:border-color="#990000"><dc:Bounds x="702" y="882" width="36" height="36"/><bpmndi:BPMNLabel color:color="#000000"><dc:Bounds x="660" y="844" width="120" height="32"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="v_gratis_di" bpmnElement="v_gratis"  bioc:fill="#ECEFFF" bioc:stroke="#03689A" color:background-color="#ECEFFF" color:border-color="#03689A"><dc:Bounds x="685" y="930" width="150" height="80"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="v_aviso_di" bpmnElement="v_aviso"  bioc:fill="#ECEFFF" bioc:stroke="#03689A" color:background-color="#ECEFFF" color:border-color="#03689A"><dc:Bounds x="885" y="930" width="150" height="80"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="v_end_di" bpmnElement="v_end"  bioc:fill="#EEAAAA" bioc:stroke="#990000" color:background-color="#EEAAAA" color:border-color="#990000"><dc:Bounds x="1102" y="952" width="36" height="36"/><bpmndi:BPMNLabel color:color="#000000"><dc:Bounds x="1060" y="992" width="120" height="32"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="fv1_di" bpmnElement="fv1"><di:waypoint x="518" y="900"/><di:waypoint x="575" y="900"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fv2_di" bpmnElement="fv2"><di:waypoint x="625" y="900"/><di:waypoint x="702" y="900"/><bpmndi:BPMNLabel><dc:Bounds x="631" y="882" width="30" height="16"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fv3_di" bpmnElement="fv3"><di:waypoint x="600" y="925"/><di:waypoint x="600" y="970"/><di:waypoint x="685" y="970"/><bpmndi:BPMNLabel><dc:Bounds x="606" y="931" width="30" height="16"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fv4_di" bpmnElement="fv4"><di:waypoint x="835" y="970"/><di:waypoint x="885" y="970"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fv5_di" bpmnElement="fv5"><di:waypoint x="1035" y="970"/><di:waypoint x="1102" y="970"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
