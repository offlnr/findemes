<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="defs_sp_desvincular" targetNamespace="https://findemes.cl/bpmn" exporter="generate_bpmn.py">
<bpmn:collaboration id="collab_sp_desvincular">
<bpmn:participant id="pool_sp_desvincular" name="Fin de Mes" processRef="proc_sp_desvincular"/>
</bpmn:collaboration>
<bpmn:process id="proc_sp_desvincular" name="Desvincular el banco" isExecutable="false">
<bpmn:startEvent id="d_start" name=""><bpmn:outgoing>fd1</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="d_revoca" name="Revocar el vínculo en Fintoc"><bpmn:incoming>fd1</bpmn:incoming><bpmn:outgoing>fd2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="d_borra" name="Borrar la credencial cifrada"><bpmn:incoming>fd2</bpmn:incoming><bpmn:outgoing>fd3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="d_end" name=""><bpmn:incoming>fd3</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="fd1" name="" sourceRef="d_start" targetRef="d_revoca"/>
<bpmn:sequenceFlow id="fd2" name="" sourceRef="d_revoca" targetRef="d_borra"/>
<bpmn:sequenceFlow id="fd3" name="" sourceRef="d_borra" targetRef="d_end"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="dia_sp_desvincular" name="Desvincular el banco"><bpmndi:BPMNPlane id="plane_sp_desvincular" bpmnElement="collab_sp_desvincular">
<bpmndi:BPMNShape id="pool_sp_desvincular_di" bpmnElement="pool_sp_desvincular" isHorizontal="true"><dc:Bounds x="1942" y="800" width="566" height="160"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="d_start_di" bpmnElement="d_start"  bioc:fill="#E6FF97" bioc:stroke="#62A715" color:background-color="#E6FF97" color:border-color="#62A715"><dc:Bounds x="2012" y="862" width="36" height="36"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="d_revoca_di" bpmnElement="d_revoca"  bioc:fill="#ECEFFF" bioc:stroke="#03689A" color:background-color="#ECEFFF" color:border-color="#03689A"><dc:Bounds x="2075" y="840" width="150" height="80"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="d_borra_di" bpmnElement="d_borra"  bioc:fill="#ECEFFF" bioc:stroke="#03689A" color:background-color="#ECEFFF" color:border-color="#03689A"><dc:Bounds x="2255" y="840" width="150" height="80"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="d_end_di" bpmnElement="d_end"  bioc:fill="#EEAAAA" bioc:stroke="#990000" color:background-color="#EEAAAA" color:border-color="#990000"><dc:Bounds x="2432" y="862" width="36" height="36"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="fd1_di" bpmnElement="fd1"><di:waypoint x="2048" y="880"/><di:waypoint x="2075" y="880"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fd2_di" bpmnElement="fd2"><di:waypoint x="2225" y="880"/><di:waypoint x="2255" y="880"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fd3_di" bpmnElement="fd3"><di:waypoint x="2405" y="880"/><di:waypoint x="2432" y="880"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
