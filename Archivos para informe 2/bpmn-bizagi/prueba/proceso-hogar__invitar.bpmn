<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="defs_sp_invitar" targetNamespace="https://findemes.cl/bpmn" exporter="generate_bpmn.py">
<bpmn:collaboration id="collab_sp_invitar">
<bpmn:participant id="pool_sp_invitar" name="Administrador de hogar" processRef="proc_sp_invitar"/>
</bpmn:collaboration>
<bpmn:process id="proc_sp_invitar" name="Invitar a un miembro" isExecutable="false">
<bpmn:startEvent id="i_start" name=""><bpmn:outgoing>fi1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="i_correo" name="Ingresar el correo de la persona invitada"><bpmn:incoming>fi1</bpmn:incoming><bpmn:incoming>fi8</bpmn:incoming><bpmn:outgoing>fi2</bpmn:outgoing></bpmn:userTask>
<bpmn:eventBasedGateway id="i_espera" name=""><bpmn:incoming>fi2</bpmn:incoming><bpmn:outgoing>fi3</bpmn:outgoing><bpmn:outgoing>fi4</bpmn:outgoing></bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="i_plazo" name="7 días sin respuesta"><bpmn:incoming>fi3</bpmn:incoming><bpmn:outgoing>fi5</bpmn:outgoing><bpmn:timerEventDefinition id="i_plazo_def"/></bpmn:intermediateCatchEvent>
<bpmn:userTask id="i_decide" name="Decidir si reenviar la invitación"><bpmn:incoming>fi5</bpmn:incoming><bpmn:outgoing>fi6</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="i_reenvia" name="¿Reenviar?"><bpmn:incoming>fi6</bpmn:incoming><bpmn:outgoing>fi7</bpmn:outgoing><bpmn:outgoing>fi8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="i_vencida" name="Invitación vencida"><bpmn:incoming>fi7</bpmn:incoming></bpmn:endEvent>
<bpmn:intermediateCatchEvent id="i_acepto" name="Miembro incorporado"><bpmn:incoming>fi4</bpmn:incoming><bpmn:outgoing>fi9</bpmn:outgoing><bpmn:messageEventDefinition id="i_acepto_def"/></bpmn:intermediateCatchEvent>
<bpmn:endEvent id="i_fin" name="Invitación aceptada"><bpmn:incoming>fi9</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="fi1" name="" sourceRef="i_start" targetRef="i_correo"/>
<bpmn:sequenceFlow id="fi2" name="" sourceRef="i_correo" targetRef="i_espera"/>
<bpmn:sequenceFlow id="fi3" name="" sourceRef="i_espera" targetRef="i_plazo"/>
<bpmn:sequenceFlow id="fi4" name="" sourceRef="i_espera" targetRef="i_acepto"/>
<bpmn:sequenceFlow id="fi5" name="" sourceRef="i_plazo" targetRef="i_decide"/>
<bpmn:sequenceFlow id="fi6" name="" sourceRef="i_decide" targetRef="i_reenvia"/>
<bpmn:sequenceFlow id="fi7" name="No" sourceRef="i_reenvia" targetRef="i_vencida"/>
<bpmn:sequenceFlow id="fi8" name="Sí" sourceRef="i_reenvia" targetRef="i_correo"/>
<bpmn:sequenceFlow id="fi9" name="" sourceRef="i_acepto" targetRef="i_fin"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="dia_sp_invitar" name="Invitar a un miembro"><bpmndi:BPMNPlane id="plane_sp_invitar" bpmnElement="collab_sp_invitar">
<bpmndi:BPMNShape id="pool_sp_invitar_di" bpmnElement="pool_sp_invitar" isHorizontal="true"><dc:Bounds x="262" y="45" width="928" height="349"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="i_start_di" bpmnElement="i_start"  bioc:fill="#E6FF97" bioc:stroke="#62A715" color:background-color="#E6FF97" color:border-color="#62A715"><dc:Bounds x="332" y="182" width="36" height="36"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="i_correo_di" bpmnElement="i_correo"  bioc:fill="#ECEFFF" bioc:stroke="#03689A" color:background-color="#ECEFFF" color:border-color="#03689A"><dc:Bounds x="395" y="160" width="150" height="80"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="i_espera_di" bpmnElement="i_espera"  bioc:fill="#FFFFCC" bioc:stroke="#A6A61D" color:background-color="#FFFFCC" color:border-color="#A6A61D"><dc:Bounds x="595" y="175" width="50" height="50"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="i_plazo_di" bpmnElement="i_plazo"  bioc:fill="#FFFFFF" bioc:stroke="#03689A" color:background-color="#FFFFFF" color:border-color="#03689A"><dc:Bounds x="712" y="182" width="36" height="36"/><bpmndi:BPMNLabel color:color="#000000"><dc:Bounds x="670" y="144" width="120" height="32"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="i_decide_di" bpmnElement="i_decide"  bioc:fill="#ECEFFF" bioc:stroke="#03689A" color:background-color="#ECEFFF" color:border-color="#03689A"><dc:Bounds x="805" y="160" width="150" height="80"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="i_reenvia_di" bpmnElement="i_reenvia" isMarkerVisible="true" bioc:fill="#FFFFCC" bioc:stroke="#A6A61D" color:background-color="#FFFFCC" color:border-color="#A6A61D"><dc:Bounds x="985" y="175" width="50" height="50"/><bpmndi:BPMNLabel color:color="#000000"><dc:Bounds x="970" y="229" width="80" height="16"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="i_vencida_di" bpmnElement="i_vencida"  bioc:fill="#EEAAAA" bioc:stroke="#990000" color:background-color="#EEAAAA" color:border-color="#990000"><dc:Bounds x="1072" y="182" width="36" height="36"/><bpmndi:BPMNLabel color:color="#000000"><dc:Bounds x="1030" y="222" width="120" height="32"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="i_acepto_di" bpmnElement="i_acepto"  bioc:fill="#FFFFFF" bioc:stroke="#03689A" color:background-color="#FFFFFF" color:border-color="#03689A"><dc:Bounds x="712" y="282" width="36" height="36"/><bpmndi:BPMNLabel color:color="#000000"><dc:Bounds x="670" y="244" width="120" height="32"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="i_fin_di" bpmnElement="i_fin"  bioc:fill="#EEAAAA" bioc:stroke="#990000" color:background-color="#EEAAAA" color:border-color="#990000"><dc:Bounds x="842" y="282" width="36" height="36"/><bpmndi:BPMNLabel color:color="#000000"><dc:Bounds x="800" y="322" width="120" height="32"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="fi1_di" bpmnElement="fi1"><di:waypoint x="368" y="200"/><di:waypoint x="395" y="200"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fi2_di" bpmnElement="fi2"><di:waypoint x="545" y="200"/><di:waypoint x="595" y="200"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fi3_di" bpmnElement="fi3"><di:waypoint x="645" y="200"/><di:waypoint x="712" y="200"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fi4_di" bpmnElement="fi4"><di:waypoint x="620" y="225"/><di:waypoint x="620" y="300"/><di:waypoint x="712" y="300"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fi5_di" bpmnElement="fi5"><di:waypoint x="748" y="200"/><di:waypoint x="805" y="200"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fi6_di" bpmnElement="fi6"><di:waypoint x="955" y="200"/><di:waypoint x="985" y="200"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fi7_di" bpmnElement="fi7"><di:waypoint x="1035" y="200"/><di:waypoint x="1072" y="200"/><bpmndi:BPMNLabel><dc:Bounds x="1041" y="182" width="30" height="16"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fi8_di" bpmnElement="fi8"><di:waypoint x="1010" y="175"/><di:waypoint x="1010" y="85"/><di:waypoint x="470" y="85"/><di:waypoint x="470" y="160"/><bpmndi:BPMNLabel><dc:Bounds x="1018" y="110" width="30" height="16"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fi9_di" bpmnElement="fi9"><di:waypoint x="748" y="300"/><di:waypoint x="842" y="300"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
