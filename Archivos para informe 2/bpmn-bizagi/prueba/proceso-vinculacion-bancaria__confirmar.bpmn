<bpmndi:BPMNEdge id="fc10_di" bpmnElement="fc10"><di:waypoint x="1530" y="200"/><di:waypoint x="1567" y="200"/><bpmndi:BPMNLabel><dc:Bounds x="1532" y="182" width="30" height="16"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
