<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="defs_sp_vincular" targetNamespace="https://findemes.cl/bpmn" exporter="generate_bpmn.py">
<bpmn:collaboration id="collab_sp_vincular">
<bpmn:participant id="pool_sp_vincular" name="Fin de Mes" processRef="proc_sp_vincular"/>
</bpmn:collaboration>
<bpmn:process id="proc_sp_vincular" name="Vincular el banco" isExecutable="false">
<bpmn:startEvent id="v_start" name=""><bpmn:outgoing>fv1</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="v_intent" name="Solicitar a Fintoc el inicio del vínculo"><bpmn:incoming>fv1</bpmn:incoming><bpmn:outgoing>fv2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:intermediateCatchEvent id="v_token" name="Vínculo creado"><bpmn:incoming>fv2</bpmn:incoming><bpmn:outgoing>fv3</bpmn:outgoing><bpmn:messageEventDefinition id="v_token_def"/></bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="v_cifra" name="Guardar cifrada la credencial del vínculo"><bpmn:incoming>fv3</bpmn:incoming><bpmn:outgoing>fv4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="v_end" name=""><bpmn:incoming>fv4</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="fv1" name="" sourceRef="v_start" targetRef="v_intent"/>
<bpmn:sequenceFlow id="fv2" name="" sourceRef="v_intent" targetRef="v_token"/>
<bpmn:sequenceFlow id="fv3" name="" sourceRef="v_token" targetRef="v_cifra"/>
<bpmn:sequenceFlow id="fv4" name="" sourceRef="v_cifra" targetRef="v_end"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="dia_sp_vincular" name="Vincular el banco"><bpmndi:BPMNPlane id="plane_sp_vincular" bpmnElement="collab_sp_vincular">
<bpmndi:BPMNShape id="pool_sp_vincular_di" bpmnElement="pool_sp_vincular" isHorizontal="true"><dc:Bounds x="232" y="600" width="706" height="160"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="v_start_di" bpmnElement="v_start"  bioc:fill="#E6FF97" bioc:stroke="#62A715" color:background-color="#E6FF97" color:border-color="#62A715"><dc:Bounds x="302" y="662" width="36" height="36"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="v_intent_di" bpmnElement="v_intent"  bioc:fill="#ECEFFF" bioc:stroke="#03689A" color:background-color="#ECEFFF" color:border-color="#03689A"><dc:Bounds x="355" y="640" width="150" height="80"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="v_token_di" bpmnElement="v_token"  bioc:fill="#FFFFFF" bioc:stroke="#03689A" color:background-color="#FFFFFF" color:border-color="#03689A"><dc:Bounds x="602" y="662" width="36" height="36"/><bpmndi:BPMNLabel color:color="#000000"><dc:Bounds x="560" y="702" width="120" height="16"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="v_cifra_di" bpmnElement="v_cifra"  bioc:fill="#ECEFFF" bioc:stroke="#03689A" color:background-color="#ECEFFF" color:border-color="#03689A"><dc:Bounds x="685" y="640" width="150" height="80"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="v_end_di" bpmnElement="v_end"  bioc:fill="#EEAAAA" bioc:stroke="#990000" color:background-color="#EEAAAA" color:border-color="#990000"><dc:Bounds x="862" y="662" width="36" height="36"/><bpmndi:BPMNLabel color:color="#000000"/></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="fv1_di" bpmnElement="fv1"><di:waypoint x="338" y="680"/><di:waypoint x="355" y="680"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fv2_di" bpmnElement="fv2"><di:waypoint x="505" y="680"/><di:waypoint x="602" y="680"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fv3_di" bpmnElement="fv3"><di:waypoint x="638" y="680"/><di:waypoint x="685" y="680"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fv4_di" bpmnElement="fv4"><di:waypoint x="835" y="680"/><di:waypoint x="862" y="680"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
